<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_Default">
    <standard_surface name="SR_default" type="surfaceshader">
      <input name="base_color" type="color3" value="0.8, 0.8, 0.8" />
      <input name="specular_roughness" type="float" value="0.2" />
      <input name="sheen_roughness" type="float" value="0.3" />
      <input name="coat_roughness" type="float" value="0.1" />
    </standard_surface>
    <output name="surfaceshader" type="surfaceshader" nodename="SR_default" />
  </nodegraph>
  <surfacematerial name="Default" type="material">
    <input name="surfaceshader" type="surfaceshader" nodegraph="NG_Default" output="surfaceshader" />
  </surfacematerial>
</materialx>
