<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_M_OnyxHextiled">
    <convert name="tiling_vector2" type="vector2">
      <input name="in" type="float" value="4" />
    </convert>
    <hextiledimage name="image_color" type="color3">
      <input name="falloff" type="float" value="0.75" />
      <input name="file" type="filename" value="../../../Images/onyx_color.jpg" colorspace="srgb_texture" />
      <input name="tiling" type="vector2" nodename="tiling_vector2" />
    </hextiledimage>
    <hextiledimage name="image_roughness" type="color3">
      <input name="falloff" type="float" value="0.75" />
      <input name="file" type="filename" value="../../../Images/onyx_roughness.jpg" colorspace="none" />
      <input name="tiling" type="vector2" nodename="tiling_vector2" />
    </hextiledimage>
    <extract name="image_roughness_float" type="float">
      <input name="in" type="color3" nodename="image_roughness" />
    </extract>
    <standard_surface name="N_StandardSurface" type="surfaceshader">
      <input name="base_color" type="color3" nodename="image_color" />
      <input name="specular_roughness" type="float" nodename="image_roughness_float" />
    </standard_surface>
    <output name="surfaceshader" type="surfaceshader" nodename="N_StandardSurface" />
  </nodegraph>
  <surfacematerial name="M_OnyxHextiled" type="material">
    <input name="surfaceshader" type="surfaceshader" nodegraph="NG_M_OnyxHextiled" output="surfaceshader" />
  </surfacematerial>
</materialx>
