      <input name="subsurface_radius" type="color3" nodename="diffuse1" />
      <input name="normal" type="vector3" nodename="mtlxnormalmap3" />
    </standard_surface>
    <output name="surfaceshader" type="surfaceshader" nodename="Queen_W" />
  </nodegraph>
  <surfacematerial name="M_Queen_W" type="material">
    <input name="surfaceshader" type="surfaceshader" nodegraph="NG_M_Queen_W" output="surfaceshader" />
