<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_Chrome">
    <standard_surface name="SR_chrome" type="surfaceshader">
      <input name="base_color" type="color3" value="1, 1, 1" />
      <input name="metalness" type="float" value="1" />
      <input name="specular_roughness" type="float" value="0" />
    </standard_surface>
    <output name="surfaceshader" type="surfaceshader" nodename="SR_chrome" />
  </nodegraph>
  <surfacematerial name="Chrome" type="material">
    <input name="surfaceshader" type="surfaceshader" nodegraph="NG_Chrome" output="surfaceshader" />
  </surfacematerial>
</materialx>
