<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_Tiled_Brass">
    <tiledimage name="image_color" type="color3">
      <input name="file" type="filename" value="../../../Images/brass_color.jpg" colorspace="srgb_texture" />
    </tiledimage>
    <tiledimage name="image_roughness" type="float">
      <input name="file" type="filename" value="../../../Images/brass_roughness.jpg" colorspace="none" />
    </tiledimage>
    <standard_surface name="SR_brass1" type="surfaceshader">
      <input name="base_color" type="color3" value="1, 1, 1" />
      <input name="metalness" type="float" value="1" />
      <input name="specular" type="float" value="0" />
      <input name="coat" type="float" value="1" />
      <input name="specular_roughness" type="float" nodename="image_roughness" />
      <input name="coat_color" type="color3" nodename="image_color" />
      <input name="coat_roughness" type="float" nodename="image_roughness" />
    </standard_surface>
    <output name="surfaceshader" type="surfaceshader" nodename="SR_brass1" />
  </nodegraph>
  <surfacematerial name="Tiled_Brass" type="material">
    <input name="surfaceshader" type="surfaceshader" nodegraph="NG_Tiled_Brass" output="surfaceshader" />
  </surfacematerial>

  <nodegraph name="NG_Greysphere_Calibration">
    <texcoord name="texcoord1" type="vector2" />
    <place2d name="place2d" type="vector2">
      <input name="pivot" type="vector2" value="0.5, 0.5" />
      <input name="scale" type="vector2" value="0.21, 0.21" />
      <input name="offset" type="vector2" value="-1.66, -0.49" />
      <input name="texcoord" type="vector2" nodename="texcoord1" />
    </place2d>
    <image name="image1" type="color3">
      <input name="uaddressmode" type="string" value="clamp" />
      <input name="vaddressmode" type="string" value="clamp" />
      <input name="texcoord" type="vector2" nodename="place2d" />
      <input name="file" type="filename" value="../../../Images/greysphere_calibration.png" colorspace="srgb_texture" />
    </image>
    <standard_surface name="SR_Greysphere_Calibration" type="surfaceshader">
      <input name="specular_roughness" type="float" value="0.7" />
      <input name="base_color" type="color3" nodename="image1" />
    </standard_surface>
    <output name="surfaceshader" type="surfaceshader" nodename="SR_Greysphere_Calibration" />
  </nodegraph>
  <surfacematerial name="Greysphere_Calibration" type="material">
    <input name="surfaceshader" type="surfaceshader" nodegraph="NG_Greysphere_Calibration" output="surfaceshader" />
  </surfacematerial>
</materialx>
