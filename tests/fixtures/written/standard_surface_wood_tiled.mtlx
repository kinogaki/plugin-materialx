<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_Tiled_Wood">
    <tiledimage name="image_color" type="color3">
      <input name="uvtiling" type="vector2" value="4, 4" />
      <input name="file" type="filename" value="../../../Images/wood_color.jpg" colorspace="srgb_texture" />
    </tiledimage>
    <tiledimage name="image_roughness" type="float">
      <input name="uvtiling" type="vector2" value="4, 4" />
      <input name="file" type="filename" value="../../../Images/wood_roughness.jpg" />
    </tiledimage>
    <standard_surface name="SR_wood1" type="surfaceshader">
      <input name="specular" type="float" value="0.4" />
      <input name="specular_anisotropy" type="float" value="0.5" />
      <input name="coat" type="float" value="0.1" />
      <input name="coat_roughness" type="float" value="0.2" />
      <input name="coat_anisotropy" type="float" value="0.5" />
      <input name="base_color" type="color3" nodename="image_color" />
      <input name="specular_roughness" type="float" nodename="image_roughness" />
    </standard_surface>
    <output name="surfaceshader" type="surfaceshader" nodename="SR_wood1" />
  </nodegraph>
  <surfacematerial name="Tiled_Wood" type="material">
    <input name="surfaceshader" type="surfaceshader" nodegraph="NG_Tiled_Wood" output="surfaceshader" />
  </surfacematerial>
</materialx>
